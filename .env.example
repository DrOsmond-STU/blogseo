# Port server
PORT=3000

# URL publik aplikasi ini (dipakai untuk callback OAuth Google & URL gambar yang di-upload).
# Contoh saat lokal: http://localhost:3000   | Saat online: https://seo.domainanda.com
PUBLIC_BASE_URL=http://localhost:3000

# Password untuk masuk dashboard (username bebas). WAJIB diisi jika server bisa diakses publik.
ADMIN_PASSWORD=

# Claude API untuk menulis artikel dengan narasi berbeda-beda.
# Kosongkan untuk memakai mode template (tanpa AI, kualitas lebih rendah).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# Google OAuth untuk Blogger (buat di https://console.cloud.google.com/apis/credentials,
# aktifkan "Blogger API v3", tipe "Web application",
# Authorized redirect URI: {PUBLIC_BASE_URL}/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Folder penyimpanan data (database JSON + gambar upload)
DATA_DIR=./data
